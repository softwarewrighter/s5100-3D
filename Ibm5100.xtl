  t := t c_at l:simplifyTest
  t := t c_at l:simplifyRatio80
  t := t c_at ((0.98 0.98 0.98, 0.8) bp:l_ights 0)
  t := t c_at ((1280, 720, 32) bp:s_etup 0)
  t := t c_at (bp:s_amples 32)
